# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=connectsphere
DB_USER=postgres
DB_PASSWORD=postgres

# --- Auth ---
# Use long, random, secret strings in real deployments. Never commit real secrets.
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- Tentative venue holds (Week 7) ---
# Expiry given to a hold when the coordinator does not set one (capped at the slot start).
HOLD_DEFAULT_DURATION_HOURS=72
# Coordinators get an "expiring soon" notification this many hours before the deadline.
HOLD_EXPIRY_WARNING_HOURS=24
# How often the background sweep expires due holds and sends notifications.
HOLD_EXPIRY_SWEEP_INTERVAL_MS=60000
